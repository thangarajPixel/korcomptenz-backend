{
  "collectionName": "components_contact_us_news_letters",
  "info": {
    "displayName": "news-letter",
    "icon": "phone"
  },
  "options": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "buttonText": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "isForm"
            },
            false
          ]
        }
      }
    },
    "link": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "isForm"
            },
            false
          ]
        }
      }
    },
    "isForm": {
      "type": "boolean",
      "default": false
    },
    "form": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::form.form",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "isForm"
            },
            true
          ]
        }
      }
    }
  },
  "config": {}
}
