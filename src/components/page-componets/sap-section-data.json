{
  "collectionName": "components_service_sap_section_data",
  "info": {
    "displayName": "sap-section-data"
  },
  "options": {},
  "attributes": {
    "heading": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "card": {
      "type": "component",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "isItemOnly"
            },
            false
          ]
        }
      },
      "component": "page-componets.card",
      "repeatable": false
    },
    "imageSection": {
      "type": "component",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "isItemOnly"
            },
            false
          ]
        }
      },
      "component": "page-componets.sap-image-section",
      "repeatable": false
    },
    "isSecoundImage": {
      "type": "boolean",
      "default": false
    },
    "image3": {
      "type": "media",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "isSecoundImage"
            },
            true
          ]
        }
      },
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "isItemOnly": {
      "type": "boolean",
      "default": false
    },
    "item": {
      "type": "component",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "isItemOnly"
            },
            true
          ]
        }
      },
      "component": "page-componets.card",
      "repeatable": true
    },
    "itemDescription": {
      "type": "text"
    }
  },
  "config": {}
}
