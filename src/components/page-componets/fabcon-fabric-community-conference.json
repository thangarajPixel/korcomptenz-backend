{
  "collectionName": "components_page_componets_fabcon_fabric_community_conferences",
  "info": {
    "displayName": "fabcon-fabric-community-conference",
    "icon": "cast"
  },
  "options": {},
  "attributes": {
    "title1": {
      "type": "text"
    },
    "title2": {
      "type": "text"
    },
    "fabconColor": {
      "type": "enumeration",
      "enum": [
        "title1",
        "title2"
      ]
    },
    "backgroundImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "description": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "date": {
      "type": "text"
    },
    "location": {
      "type": "string"
    },
    "buttonText": {
      "type": "string"
    },
    "buttonLink": {
      "type": "string"
    },
    "isTarget": {
      "type": "boolean",
      "default": false
    },
    "form": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::form.form"
    },
    "isForm": {
      "type": "boolean"
    },
    "emailSubject": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "isForm"
            },
            true
          ]
        }
      }
    },
    "emailBody": {
      "type": "customField",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "isForm"
            },
            true
          ]
        }
      },
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "formTitle": {
      "type": "customField",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "isForm"
            },
            true
          ]
        }
      },
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "formDescription": {
      "type": "customField",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "isForm"
            },
            true
          ]
        }
      },
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "formImage": {
      "type": "media",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "isForm"
            },
            true
          ]
        }
      },
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "formbuttonText": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "isForm"
            },
            true
          ]
        }
      }
    }
  },
  "config": {}
}
