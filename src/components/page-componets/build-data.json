{
  "collectionName": "components_service_build_data",
  "info": {
    "displayName": "build-data"
  },
  "options": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "isBgGray": {
      "type": "boolean",
      "default": false
    },
    "description": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "descriptionButtonText": {
      "type": "string"
    },
    "descriptionButtonLink": {
      "type": "string"
    },
    "isSwap": {
      "type": "boolean",
      "default": false
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "mobileImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "link": {
      "type": "string"
    },
    "buttonText": {
      "type": "string"
    },
    "imageCaption": {
      "type": "string"
    },
    "rightSection": {
      "type": "component",
      "component": "sub-page-componets.build-data-right-section",
      "repeatable": false
    },
    "isTargetBlankDescription": {
      "type": "boolean",
      "default": false
    },
    "descriptiontitle": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "isSwap"
            },
            true
          ]
        }
      }
    }
  },
  "config": {}
}
