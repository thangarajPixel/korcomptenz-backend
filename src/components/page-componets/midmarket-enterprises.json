{
  "collectionName": "components_page_componets_midmarket_enterprises",
  "info": {
    "displayName": "midmarket-enterprises",
    "icon": "clock"
  },
  "options": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "topTitle": {
      "type": "string"
    },
    "topDescription": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "noOfColumn": {
      "type": "enumeration",
      "enum": [
        "grid-cols-2",
        "grid-cols-3",
        "grid-cols-4",
        "grid-cols-5",
        "grid-cols--6"
      ]
    },
    "isBackground": {
      "type": "boolean",
      "default": false
    },
    "backgroundColor": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "isBackground"
            },
            false
          ]
        }
      }
    },
    "backgroundImage": {
      "type": "media",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "isBackground"
            },
            true
          ]
        }
      },
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "list": {
      "type": "component",
      "component": "page-componets.midmarket-enterprises-list",
      "repeatable": true
    }
  },
  "config": {}
}
