{
  "collectionName": "components_page_componets_gram_banners",
  "info": {
    "displayName": "gram-banner",
    "icon": "chartPie"
  },
  "options": {},
  "attributes": {
    "title": {
      "type": "text"
    },
    "description": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "mobileImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "buttonText": {
      "type": "text"
    },
    "buttonLink": {
      "type": "text"
    },
    "theme": {
      "type": "enumeration",
      "enum": [
        "default",
        "dark",
        "light",
        "blank"
      ]
    },
    "isCustomList": {
      "type": "boolean",
      "default": false
    },
    "list": {
      "type": "component",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "isCustomList"
            },
            true
          ]
        }
      },
      "component": "sub-page-componets.gram-banner-list",
      "repeatable": true
    },
    "isTitleLeft": {
      "type": "boolean",
      "default": false
    },
    "isDescriptionLeft": {
      "type": "boolean",
      "default": false
    },
    "isTargetBlank": {
      "type": "boolean",
      "default": false
    },
    "isFooter": {
      "type": "boolean",
      "default": false
    },
    "footerDescription": {
      "type": "customField",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "isFooter"
            },
            true
          ]
        }
      },
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "FooterbuttonText": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "isFooter"
            },
            true
          ]
        }
      }
    },
    "footerButtonLink": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "isFooter"
            },
            true
          ]
        }
      }
    },
    "footerHeading": {
      "type": "text",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "isFooter"
            },
            true
          ]
        }
      }
    }
  },
  "config": {}
}
