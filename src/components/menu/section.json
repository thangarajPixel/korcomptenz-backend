{
  "collectionName": "components_menu_sections",
  "info": {
    "displayName": "service-menu"
  },
  "options": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "image": {
      "type": "media",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "isText"
            },
            false
          ]
        }
      },
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "footerLink": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::page.page"
    },
    "items": {
      "type": "component",
      "component": "menu.items",
      "repeatable": true
    },
    "isText": {
      "type": "boolean",
      "default": false
    },
    "description": {
      "type": "text",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "isText"
            },
            true
          ]
        }
      }
    },
    "bgColor": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "isText"
            },
            true
          ]
        }
      }
    }
  },
  "config": {}
}
