{
  "collectionName": "components_home_headers",
  "info": {
    "displayName": "header"
  },
  "options": {},
  "attributes": {
    "label": {
      "type": "string"
    },
    "hasChild": {
      "type": "boolean",
      "default": true
    },
    "childKey": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "hasChild"
            },
            true
          ]
        }
      },
      "required": true
    },
    "isButton": {
      "type": "boolean"
    },
    "href": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::page.page"
    }
  },
  "config": {}
}
