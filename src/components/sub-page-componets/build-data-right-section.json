{
  "collectionName": "components_sub_page_componets_build_data_right_sections",
  "info": {
    "displayName": "build-data-right-section",
    "icon": "chartPie"
  },
  "options": {},
  "attributes": {
    "content": {
      "type": "enumeration",
      "enum": [
        "image",
        "description",
        "form"
      ]
    },
    "responsiveImage": {
      "type": "component",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "content"
            },
            "image"
          ]
        }
      },
      "component": "sub-page-componets.responsive-image",
      "repeatable": false
    },
    "description": {
      "type": "customField",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "content"
            },
            "description"
          ]
        }
      },
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "form": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::form.form",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "content"
            },
            "form"
          ]
        }
      }
    }
  },
  "config": {}
}