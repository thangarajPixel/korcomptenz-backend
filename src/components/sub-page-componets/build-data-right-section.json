{
  "collectionName": "components_sub_page_componets_build_data_right_sections",
  "info": {
    "displayName": "build-data-right-section",
    "icon": "chartPie"
  },
  "options": {},
  "attributes": {
    "content": {
      "type": "enumeration",
      "enum": [
        "image",
        "description",
        "form",
        "video",
        "customDescription"
      ]
    },
    "responsiveImage": {
      "type": "component",
      "conditions": {
        "visible": {
          "or": [
            {
              "==": [
                {
                  "var": "content"
                },
                "image"
              ]
            },
            {
              "==": [
                {
                  "var": "content"
                },
                "video"
              ]
            }
          ]
        }
      },
      "component": "sub-page-componets.responsive-image",
      "repeatable": false
    },
    "rightsideTitle": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "content"
            },
            "description"
          ]
        }
      }
    },
    "description": {
      "type": "customField",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "content"
            },
            "description"
          ]
        }
      },
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "form": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::form.form",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "content"
            },
            "form"
          ]
        }
      }
    },
    "videoLink": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "content"
            },
            "video"
          ]
        }
      }
    },
    "videoButtonText": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "content"
            },
            "video"
          ]
        }
      }
    },
    "customTitle": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "content"
            },
            "customDescription"
          ]
        }
      }
    },
    "customDescription": {
      "type": "component",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "content"
            },
            "customDescription"
          ]
        }
      },
      "component": "global.custom-list",
      "repeatable": true
    },
    "isBgGray": {
      "type": "boolean",
      "default": false
    },
    "customDescriptionImage": {
      "type": "media",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "content"
            },
            "customDescription"
          ]
        }
      },
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    }
  },
  "config": {}
}
