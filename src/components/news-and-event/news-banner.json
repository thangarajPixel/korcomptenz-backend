{
  "collectionName": "components_news_and_event_news_banners",
  "info": {
    "displayName": "news-banner",
    "icon": "archive"
  },
  "options": {},
  "attributes": {
    "title": {
      "type": "text"
    },
    "image": {
      "type": "media",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "isVideo"
            },
            false
          ]
        }
      },
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "isVideo": {
      "type": "boolean",
      "default": false
    },
    "videoLink": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "isVideo"
            },
            true
          ]
        }
      }
    },
    "form": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::form.form"
    },
    "description": {
      "type": "text"
    },
    "buttonText": {
      "type": "string"
    },
    "buttonLink": {
      "type": "string"
    },
    "isTarget": {
      "type": "boolean",
      "default": false
    },
    "isForm": {
      "type": "boolean",
      "default": false
    },
    "formButtonText": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "isForm"
            },
            true
          ]
        }
      }
    },
    "emailSubject": {
      "type": "customField",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "isForm"
            },
            true
          ]
        }
      },
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "emailBody": {
      "type": "customField",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "isForm"
            },
            true
          ]
        }
      },
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "formTitle": {
      "type": "customField",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "isForm"
            },
            true
          ]
        }
      },
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "formDescription": {
      "type": "customField",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "isForm"
            },
            true
          ]
        }
      },
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "formImage": {
      "type": "media",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "isForm"
            },
            true
          ]
        }
      },
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "sapForm": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::form.form",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "isForm"
            },
            true
          ]
        }
      }
    }
  },
  "config": {}
}
