{
  "collectionName": "components_news_and_event_news_banners",
  "info": {
    "displayName": "news-banner",
    "icon": "archive"
  },
  "options": {},
  "attributes": {
    "title": {
      "type": "text"
    },
    "image": {
      "type": "media",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "isVideo"
            },
            false
          ]
        }
      },
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "isVideo": {
      "type": "boolean",
      "default": false
    },
    "videoLink": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "isVideo"
            },
            true
          ]
        }
      }
    },
    "form": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::form.form"
    },
    "description": {
      "type": "text"
    }
  },
  "config": {}
}
