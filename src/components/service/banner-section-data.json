{
  "collectionName": "components_service_banner_section_data",
  "info": {
    "displayName": "Banner-section-data"
  },
  "options": {},
  "attributes": {
    "imageMobile": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "logoMobile": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "buttonText": {
      "type": "string",
      "default": "Contact us"
    },
    "link": {
      "type": "string"
    },
    "bannerCaption": {
      "type": "text"
    },
    "secondButton": {
      "type": "string"
    },
    "secondLink": {
      "type": "string"
    },
    "isTarget": {
      "type": "boolean",
      "default": false
    },
    "isHasFooter": {
      "type": "boolean",
      "default": false
    },
    "footer": {
      "type": "component",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "isCustomFooter"
            },
            false
          ]
        }
      },
      "component": "case-study.partner",
      "repeatable": false
    },
    "isListPage": {
      "type": "boolean",
      "default": false
    },
    "isCustomFooter": {
      "type": "boolean",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "isHasFooter"
            },
            true
          ]
        }
      },
      "default": false
    },
    "customFooter": {
      "type": "component",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "isCustomFooter"
            },
            true
          ]
        }
      },
      "component": "page-componets.custom-footer",
      "repeatable": false
    },
    "isForm": {
      "type": "boolean",
      "default": false
    },
    "formTitle": {
      "type": "customField",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "isForm"
            },
            true
          ]
        }
      },
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "formDescription": {
      "type": "customField",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "isForm"
            },
            true
          ]
        }
      },
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "formImage": {
      "type": "media",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "isForm"
            },
            true
          ]
        }
      },
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "form": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::form.form",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "isForm"
            },
            true
          ]
        }
      }
    }
  },
  "config": {}
}
