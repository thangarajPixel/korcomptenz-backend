{
  "collectionName": "components_demo_page_build_demos",
  "info": {
    "displayName": "build-demo",
    "icon": "apps"
  },
  "options": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "isSwap": {
      "type": "boolean",
      "default": false
    },
    "link": {
      "type": "string"
    },
    "buttonText": {
      "type": "string"
    },
    "item": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::book-demo.book-demo",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "formFor"
            },
            "demo"
          ]
        }
      }
    },
    "form": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::form.form"
    },
    "formFor": {
      "type": "enumeration",
      "required": true,
      "default": "demo",
      "enum": [
        "demo",
        "reserve"
      ]
    },
    "reserve_lead": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::reserve-lead.reserve-lead",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "formFor"
            },
            "reserve"
          ]
        }
      }
    }
  },
  "config": {}
}
