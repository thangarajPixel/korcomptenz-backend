{
  "collectionName": "components_demo_page_demo_demonstrations",
  "info": {
    "displayName": "demo-demonstration",
    "icon": "apps"
  },
  "options": {},
  "attributes": {
    "title": {
      "type": "text"
    },
    "description": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "list": {
      "type": "component",
      "component": "global.editor-descripiton",
      "repeatable": true
    },
    "isHasFooter": {
      "type": "boolean",
      "default": false
    },
    "footer": {
      "type": "component",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "isHasFooter"
            },
            true
          ]
        }
      },
      "component": "global.image-description",
      "repeatable": false
    }
  },
  "config": {}
}
