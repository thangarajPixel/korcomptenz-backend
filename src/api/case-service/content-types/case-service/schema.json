{
  "kind": "collectionType",
  "collectionName": "case_services",
  "info": {
    "singularName": "case-service",
    "pluralName": "case-services",
    "displayName": "case-service"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "label": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "required": true,
      "unique": true,
      "regex": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "text"
    },
    "description": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "seo": {
      "type": "component",
      "component": "seo.seo",
      "repeatable": false
    }
  }
}
