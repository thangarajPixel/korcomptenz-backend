{
  "kind": "collectionType",
  "collectionName": "new_rooms",
  "info": {
    "singularName": "new-room",
    "pluralName": "new-rooms",
    "displayName": "new-room"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true,
      "regex": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "description": {
      "type": "text"
    },
    "buttonText": {
      "type": "string",
      "default": "Book a Demo"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "attachment": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "list": {
      "type": "dynamiczone",
      "components": [
        "news-and-event.news-description-only",
        "news-and-event.news-title-description-only",
        "news-and-event.compounds-newsroom",
        "news-and-event.simple-image-gallery",
        "news-and-event.news-service",
        "news-and-event.news-banner",
        "news-and-event.color-custom-description",
        "news-and-event.testimonal-list",
        "news-and-event.build-data",
        "page-componets.gram-banner",
        "page-componets.fabcon-led-transformation",
        "page-componets.step-grid-section",
        "page-componets.cloud-readiness-report",
        "seo.seo",
        "page-componets.full-width-gram-banner",
        "page-componets.custom-script"
      ]
    },
    "seo": {
      "type": "component",
      "component": "seo.seo",
      "repeatable": false
    },
    "isForm": {
      "type": "boolean",
      "default": false
    },
    "formTitle": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "emailSubject": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "emailBody": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    }
  }
}
