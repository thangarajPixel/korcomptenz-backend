{
  "kind": "collectionType",
  "collectionName": "insights",
  "info": {
    "singularName": "insight",
    "pluralName": "insights",
    "displayName": "insight"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "seo": {
      "type": "component",
      "component": "seo.seo",
      "repeatable": false
    },
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "content": {
      "type": "enumeration",
      "required": true,
      "default": "file",
      "enum": ["file", "blog", "podcast", "post-webinar", "pre-webinar"]
    },
    "technologies": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::case-technology.case-technology"
    },
    "services": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::case-service.case-service"
    },
    "heroSection": {
      "type": "component",
      "component": "case-study.hero-section",
      "repeatable": false
    },
    "attachment": {
      "type": "media",
      "private": true,
      "multiple": false,
      "allowedTypes": ["images", "files"]
    },
    "blog": {
      "type": "component",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "content"
            },
            "blog"
          ]
        }
      },
      "component": "insight-section.blog-section",
      "repeatable": false
    },
    "category": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::insight-category.insight-category"
    }
  }
}
