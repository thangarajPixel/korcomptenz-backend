{
  "kind": "collectionType",
  "collectionName": "insights",
  "info": {
    "singularName": "insight",
    "pluralName": "insights",
    "displayName": "insight"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "seo": {
      "type": "component",
      "component": "seo.seo",
      "repeatable": false
    },
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "content": {
      "type": "enumeration",
      "required": true,
      "default": "file",
      "enum": [
        "file",
        "blog",
        "podcast",
        "post-webinar",
        "pre-webinar",
        "web-stories"
      ]
    },
    "technologies": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::case-technology.case-technology"
    },
    "tags": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::insight-tag.insight-tag"
    },
    "services": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::case-service.case-service"
    },
    "heroSection": {
      "type": "component",
      "component": "case-study.hero-section",
      "repeatable": false
    },
    "attachment": {
      "type": "media",
      "private": true,
      "multiple": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "blog": {
      "type": "component",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "content"
            },
            "blog"
          ]
        }
      },
      "component": "insight-section.blog-section",
      "repeatable": false
    },
    "category": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::insight-category.insight-category"
    },
    "isLinkOnly": {
      "type": "boolean",
      "default": false
    },
    "webinar": {
      "type": "component",
      "conditions": {
        "visible": {
          "or": [
            {
              "==": [
                {
                  "var": "content"
                },
                "post-webinar"
              ]
            },
            {
              "==": [
                {
                  "var": "content"
                },
                "pre-webinar"
              ]
            }
          ]
        }
      },
      "component": "insight-section.webinar",
      "repeatable": false
    },
    "podcast": {
      "type": "component",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "content"
            },
            "podcast"
          ]
        }
      },
      "component": "insight-section.podcast",
      "repeatable": false
    },
    "webStories": {
      "type": "component",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "content"
            },
            "web-stories"
          ]
        }
      },
      "component": "insight-section.web-stories",
      "repeatable": true
    },
    "author": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::insight-author.insight-author"
    },
    "featureImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "preWebinar": {
      "type": "component",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "content"
            },
            "pre-webinar"
          ]
        }
      },
      "component": "insight-section.post-webinar",
      "repeatable": false
    },
    "downloadBlog": {
      "type": "boolean",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "content"
            },
            "blog"
          ]
        }
      },
      "default": false
    },
    "form": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::form.form",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "downloadBlog"
            },
            true
          ]
        }
      }
    },
    "downloadButton": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "downloadBlog"
            },
            true
          ]
        }
      }
    }
  }
}
