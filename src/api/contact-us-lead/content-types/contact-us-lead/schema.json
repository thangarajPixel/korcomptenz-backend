{
  "kind": "collectionType",
  "collectionName": "contact_us_leads",
  "info": {
    "singularName": "contact-us-lead",
    "pluralName": "contact-us-leads",
    "displayName": "contact-us-lead"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "firstName": {
      "type": "string",
      "required": true
    },
    "lastName": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true
    },
    "phone": {
      "type": "string",
      "required": true
    },
    "message": {
      "type": "text",
      "required": true
    },
    "technology": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::case-technology.case-technology"
    },
    "service": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::case-service.case-service"
    }
  }
}
