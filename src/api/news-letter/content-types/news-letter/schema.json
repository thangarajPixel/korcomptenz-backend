{
  "kind": "collectionType",
  "collectionName": "news_letters",
  "info": {
    "singularName": "news-letter",
    "pluralName": "news-letters",
    "displayName": "news-letter"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true,
      "regex": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "description": {
      "type": "text"
    },
    "buttonText": {
      "type": "string",
      "default": "Book a Demo"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "isHasExternalLink": {
      "type": "boolean",
      "default": false
    },
    "externalLink": {
      "type": "string",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "isHasExternalLink"
            },
            true
          ]
        }
      }
    }
  }
}
