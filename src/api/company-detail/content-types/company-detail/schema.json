{
  "kind": "singleType",
  "collectionName": "company_details",
  "info": {
    "singularName": "company-detail",
    "pluralName": "company-details",
    "displayName": "company-detail"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "companyName": {
      "type": "string"
    },
    "social_medias": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::social-media.social-media"
    },
    "companyLogo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "companyFullLogo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    }
  }
}
